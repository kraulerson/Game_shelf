FROM node:20-alpine AS backend

WORKDIR /app

# Install build dependencies for native modules (better-sqlite3, bcrypt)
RUN apk add --no-cache python3 make g++

COPY package*.json ./
RUN npm ci --omit=dev

COPY src/ ./src/
# The rotation script is the documented recovery path for changing
# GAMESHELF_ENCRYPTION_KEY. It must be run against a STOPPED backend (see the script
# header), so the form is:
#   docker compose stop backend
#   docker compose run --rm \
#     -e GAMESHELF_ENCRYPTION_KEY=<current> \
#     -e GAMESHELF_ENCRYPTION_KEY_NEW=<new> \
#     backend node scripts/rotate-encryption-key.js
# not `docker exec`, which requires the container to be running — the very thing that
# causes the torn-key race the script warns about.
COPY scripts/ ./scripts/

# Create non-root user data directory
RUN mkdir -p /app/data && chown -R node:node /app

USER node

EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3001/api/health || exit 1

CMD ["node", "src/server.js"]

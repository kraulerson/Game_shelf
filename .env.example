# Seals every stored launcher credential. Accepts either a 32-byte key as 64 hex
# characters or base64 (used directly, and preferred), or a passphrase of 32+
# characters, which is stretched with scrypt.
#
# To CHANGE this value, do NOT just edit it — that would leave every stored
# credential unreadable. Run the rotation script first:
#
#   GAMESHELF_ENCRYPTION_KEY=<current> GAMESHELF_ENCRYPTION_KEY_NEW=<new> \
#     node scripts/rotate-encryption-key.js
#
# then set this to the new value and restart.
GAMESHELF_ENCRYPTION_KEY=change_this_to_a_random_32_plus_char_string
GAMESHELF_JWT_SECRET=change_this_too
NODE_ENV=production
PORT=3001

# The passphrase salt is stored as "encryption-salt" in this directory, so back up
# the WHOLE directory, not just the .db file — the database alone cannot be
# decrypted without it. (Not used when the key is supplied as raw 32 bytes.)
GAMESHELF_DB_PATH=/app/data/gameshelf.db
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
STEAMGRIDDB_API_KEY=

# Lancache orchestrator integration (F14). Leave unset to disable the cache UI.
ORCH_API_URL=http://192.168.1.40:8765
ORCH_TOKEN=

# Docker frontend configuration
# For development: FRONTEND_TARGET=dev FRONTEND_PORT=5173 FRONTEND_INTERNAL_PORT=5173
# For production (default): FRONTEND_TARGET=prod FRONTEND_PORT=80 FRONTEND_INTERNAL_PORT=80
FRONTEND_TARGET=prod
FRONTEND_PORT=80
FRONTEND_INTERNAL_PORT=80
